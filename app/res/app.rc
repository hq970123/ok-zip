// OK Zip resources. Control captions here are English placeholders; the app
// replaces them at runtime from its zh-CN / en string tables.
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDI_APP ICON "okzip.ico"
IDI_TB_OPEN    ICON "tb/open.ico"
IDI_TB_EXTRACT ICON "tb/extract.ico"
IDI_TB_NEW     ICON "tb/new.ico"
IDI_TB_ADD     ICON "tb/add.ico"
IDI_TB_DELETE  ICON "tb/delete.ico"
IDI_TB_TEST    ICON "tb/test.ico"
IDI_TB_VIEW    ICON "tb/view.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OK Zip"
            VALUE "FileDescription", "OK Zip Archiver"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "okzip"
            VALUE "OriginalFilename", "okzip.exe"
            VALUE "ProductName", "OK Zip"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_EXTRACT DIALOGEX 0, 0, 320, 170
STYLE DS_SETFONT | DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Extract"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Destination:", IDC_X_DEST_LABEL, 7, 7, 250, 9
    EDITTEXT        IDC_X_DEST, 7, 18, 250, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_X_BROWSE, 262, 18, 51, 14
    AUTOCHECKBOX    "Extract into a sub-folder", IDC_X_SUBFOLDER, 7, 38, 306, 10
    GROUPBOX        "If a file exists", IDC_X_OW_GROUP, 7, 54, 150, 74
    AUTORADIOBUTTON "Ask", IDC_X_OW_ASK, 14, 67, 138, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Overwrite", IDC_X_OW_OVERWRITE, 14, 81, 138, 10
    AUTORADIOBUTTON "Skip", IDC_X_OW_SKIP, 14, 95, 138, 10
    AUTORADIOBUTTON "Rename automatically", IDC_X_OW_RENAME, 14, 109, 138, 10
    GROUPBOX        "Options", IDC_X_OTHER_GROUP, 164, 54, 149, 74, WS_GROUP
    AUTOCHECKBOX    "Open folder when done", IDC_X_OPEN_AFTER, 171, 67, 136, 10, WS_TABSTOP
    LTEXT           "Password:", IDC_X_PW_LABEL, 171, 84, 136, 9
    EDITTEXT        IDC_X_PW, 171, 95, 136, 14, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "", IDC_X_SCOPE, 7, 135, 306, 9
    DEFPUSHBUTTON   "OK", IDOK, 206, 149, 51, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 262, 149, 51, 14
END

IDD_CREATE DIALOGEX 0, 0, 330, 202
STYLE DS_SETFONT | DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New archive"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Archive name:", IDC_C_PATH_LABEL, 7, 7, 260, 9
    EDITTEXT        IDC_C_PATH, 7, 18, 260, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_C_BROWSE, 272, 18, 51, 14
    GROUPBOX        "Compression", IDC_C_OPTS_GROUP, 7, 38, 156, 112
    LTEXT           "Format:", IDC_C_FMT_LABEL, 14, 53, 52, 9
    COMBOBOX        IDC_C_FORMAT, 68, 51, 88, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Level:", IDC_C_LEVEL_LABEL, 14, 73, 52, 9
    COMBOBOX        IDC_C_LEVEL, 68, 71, 88, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Split:", IDC_C_SPLIT_LABEL, 14, 93, 52, 9
    COMBOBOX        IDC_C_SPLIT, 68, 91, 88, 150, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Solid (7z)", IDC_C_SOLID, 14, 113, 142, 10, WS_TABSTOP
    GROUPBOX        "Encryption", IDC_C_ENC_GROUP, 170, 38, 153, 112
    LTEXT           "Password:", IDC_C_PW_LABEL, 177, 50, 139, 9
    EDITTEXT        IDC_C_PW, 177, 60, 139, 14, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "Confirm:", IDC_C_PW2_LABEL, 177, 77, 139, 9
    EDITTEXT        IDC_C_PW2, 177, 87, 139, 14, ES_PASSWORD | ES_AUTOHSCROLL
    AUTOCHECKBOX    "Show password", IDC_C_SHOWPW, 177, 105, 139, 10, WS_TABSTOP
    LTEXT           "Method:", IDC_C_ENCMETHOD_LABEL, 177, 120, 45, 9
    COMBOBOX        IDC_C_ENCMETHOD, 224, 118, 92, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Encrypt file names (7z)", IDC_C_ENCNAMES, 177, 136, 139, 10, WS_TABSTOP
    LTEXT           "", IDC_C_INFO, 7, 157, 316, 20
    DEFPUSHBUTTON   "OK", IDOK, 216, 181, 51, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 272, 181, 51, 14
END

IDD_PASSWORD DIALOGEX 0, 0, 230, 84
STYLE DS_SETFONT | DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Password"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Enter password:", IDC_P_PROMPT, 7, 7, 216, 18
    EDITTEXT        IDC_P_PW, 7, 27, 216, 14, ES_PASSWORD | ES_AUTOHSCROLL
    AUTOCHECKBOX    "Show password", IDC_P_SHOW, 7, 46, 120, 10, WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 116, 63, 51, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 172, 63, 51, 14
END

IDD_PROGRESS DIALOGEX 0, 0, 290, 92
STYLE DS_SETFONT | DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "OK Zip"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Working...", IDC_G_OP, 7, 7, 276, 9
    LTEXT           "", IDC_G_FILE, 7, 19, 276, 9, SS_PATHELLIPSIS | SS_NOPREFIX
    CONTROL         "", IDC_G_BAR, "msctls_progress32", WS_BORDER, 7, 33, 276, 11
    LTEXT           "", IDC_G_STATS, 7, 50, 276, 9, SS_NOPREFIX
    PUSHBUTTON      "Cancel", IDCANCEL, 232, 71, 51, 14
END

// ---- Settings property sheet pages (260 x 176 DLU) ----

IDD_PAGE_GENERAL DIALOGEX 0, 0, 260, 166
STYLE DS_SETFONT | DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "General"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Interface", IDC_S_UI_GROUP, 7, 7, 246, 50
    LTEXT           "Language:", IDC_S_LANG_LABEL, 14, 22, 70, 9
    COMBOBOX        IDC_S_LANG, 88, 20, 158, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_S_LANG_NOTE, 14, 39, 232, 9
    GROUPBOX        "Window", IDC_S_WIN_GROUP, 7, 63, 246, 30
    AUTOCHECKBOX    "Remember window", IDC_S_REMEMBER, 14, 76, 232, 10, WS_TABSTOP
    GROUPBOX        "Recent archives", IDC_S_RECENT_GROUP, 7, 99, 246, 34
    LTEXT           "", IDC_S_RECENT_TEXT, 14, 115, 160, 9
    PUSHBUTTON      "Clear list", IDC_S_RECENT_CLEAR, 180, 112, 66, 14
    LTEXT           "", IDC_S_FILE, 7, 142, 246, 9, SS_PATHELLIPSIS | SS_NOPREFIX
END

IDD_PAGE_EXTRACT DIALOGEX 0, 0, 260, 166
STYLE DS_SETFONT | DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Extract"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Toolbar Extract button", IDC_S_XT_GROUP, 7, 7, 246, 56
    AUTORADIOBUTTON "Extract here", IDC_S_XT_HERE, 14, 20, 232, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Extract to folder", IDC_S_XT_SMART, 14, 34, 232, 10
    AUTORADIOBUTTON "Ask", IDC_S_XT_ASK, 14, 48, 232, 10
    GROUPBOX        "If a file exists", IDC_S_OW_GROUP, 7, 69, 246, 70, WS_GROUP
    AUTORADIOBUTTON "Ask", IDC_S_OW_ASK, 14, 82, 232, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Overwrite", IDC_S_OW_OVERWRITE, 14, 96, 232, 10
    AUTORADIOBUTTON "Skip", IDC_S_OW_SKIP, 14, 110, 232, 10
    AUTORADIOBUTTON "Rename", IDC_S_OW_RENAME, 14, 124, 232, 10
    AUTOCHECKBOX    "Open folder when done", IDC_S_OPEN_AFTER, 9, 148, 244, 10, WS_GROUP | WS_TABSTOP
END

IDD_PAGE_COMPRESS DIALOGEX 0, 0, 260, 166
STYLE DS_SETFONT | DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Compress"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Defaults", IDC_S_C_GROUP, 7, 7, 246, 54
    LTEXT           "Format:", IDC_S_C_FMT_LABEL, 14, 22, 70, 9
    COMBOBOX        IDC_S_C_FMT, 88, 20, 158, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Level:", IDC_S_C_LEVEL_LABEL, 14, 41, 70, 9
    COMBOBOX        IDC_S_C_LEVEL, 88, 39, 158, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_S_C_NOTE, 7, 69, 246, 27
END

IDD_PAGE_SHELL DIALOGEX 0, 0, 260, 166
STYLE DS_SETFONT | DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Context menu"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Explorer context menu", IDC_S_SHELL_GROUP, 7, 7, 246, 84
    LTEXT           "", IDC_S_SHELL_TEXT, 14, 19, 232, 36
    LTEXT           "", IDC_S_STATE, 14, 57, 232, 9
    PUSHBUTTON      "Register", IDC_S_REG_MENU, 14, 70, 112, 14
    PUSHBUTTON      "Unregister", IDC_S_UNREG_MENU, 134, 70, 112, 14
    GROUPBOX        "File associations", IDC_S_ASSOC_GROUP, 7, 97, 246, 54
    PUSHBUTTON      "Associate", IDC_S_ASSOC, 14, 110, 112, 14
    PUSHBUTTON      "Remove associations", IDC_S_UNASSOC, 134, 110, 112, 14
    PUSHBUTTON      "Default apps...", IDC_S_DEFAPPS, 14, 130, 232, 14
    LTEXT           "", IDC_S_STATUS, 7, 154, 246, 11
END

// ---- Overwrite conflict ----

IDD_CONFLICT DIALOGEX 0, 0, 340, 142
STYLE DS_SETFONT | DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Confirm file replace"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_K_ICON, "Static", SS_ICON, 7, 7, 21, 20
    LTEXT           "The destination already contains this file:", IDC_K_HEADING, 34, 7, 299, 9
    LTEXT           "", IDC_K_NAME, 34, 19, 299, 11, SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT           "", IDC_K_PATH, 34, 31, 299, 9, SS_NOPREFIX | SS_PATHELLIPSIS
    GROUPBOX        "Existing file", IDC_K_OLD_GROUP, 7, 46, 160, 46
    LTEXT           "", IDC_K_OLD, 14, 58, 148, 28, SS_NOPREFIX
    GROUPBOX        "New file", IDC_K_NEW_GROUP, 173, 46, 160, 46
    LTEXT           "", IDC_K_NEW, 180, 58, 148, 28, SS_NOPREFIX
    AUTOCHECKBOX    "Apply to all", IDC_K_ALL, 7, 100, 326, 10, WS_TABSTOP
    DEFPUSHBUTTON   "Overwrite", IDC_K_OVERWRITE, 7, 121, 78, 14
    PUSHBUTTON      "Skip", IDC_K_SKIP, 90, 121, 78, 14
    PUSHBUTTON      "Rename", IDC_K_RENAME, 173, 121, 78, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 255, 121, 78, 14
END
